    "/clientes/": {
      "get": {
        "tags": [
          "Clientes"
        ],
        "summary": "Lista todos os clientes",
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      },
      "post": {
        "tags": [
          "Clientes"
        ],
        "summary": "Cadastra um cliente",
        "description": "Realiza o cadastro de um novo cliente.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string",
                  "example": "Elinton Souza"
                },
                "docIdentificacao": {
                  "type": "string",
                  "example": "12345678900"
                },
                "email": {
                  "type": "string",
                  "example": "elinton@email.com"
                },
                "telefone": {
                  "type": "string",
                  "example": "12345678900"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Cliente cadastrado com sucesso."
          },
          "400": {
            "description": "Dados Inválidos"
          }
        }
      }
    },
    "/clientes/{id}": {
      "delete": {
        "tags": [
          "Clientes"
        ],
        "summary": "Remove um cliente",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID do cliente a ser removido"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          }
        }
      },
      "put": {
        "tags": [
          "Clientes"
        ],
        "summary": "Atualiza um cliente",
        "description": "Atualiza os dados de um novo cliente.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            },
            "description": "ID do cliente a ser atualizado"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "nome": {
                  "type": "string",
                  "example": "Elinton Souza"
                },
                "docIdentificacao": {
                  "type": "string",
                  "example": "12345678900"
                },
                "email": {
                  "type": "string",
                  "example": "elinton@email.com"
                },
                "telefone": {
                  "type": "string",
                  "example": "12345678900"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente atualizado com sucesso."
          },
          "400": {
            "description": "Dados inválidos."
          }
        }
      }
    },
